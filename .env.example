# =============================================================
# NivaasBhoomi - Environment Variables
# DEV-SPEC.txt Section 3
# Copy to .env.local and fill in. NEVER commit .env.local
# =============================================================

# Database
MONGODB_URI=

# Auth
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Login OTP (WhatsApp) — the approved Meta template for the 6-digit code
WHATSAPP_OTP_TEMPLATE_NAME=login_otp
WHATSAPP_OTP_TEMPLATE_LANG=en
# Marketing template for property alerts (Phase 3) — approved name in Meta.
WHATSAPP_TEMPLATE_PROPERTY_ALERT=property_alert

# Login OTP rate limits (all optional — these are the built-in defaults).
# Sends per hour per phone / per IP, and the minimum gap between two sends to
# the same phone. Raise the IP cap for shared-network testing.
OTP_RATE_LIMIT_PHONE_PER_HOUR=5
OTP_RATE_LIMIT_IP_PER_HOUR=30
OTP_RESEND_COOLDOWN_SECONDS=30

# n8n
N8N_WEBHOOK_URL=
N8N_API_KEY=

# Razorpay (Phase 7)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
